{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-zero-network/schemas/circulation-observation-v0.6.schema.json",
  "title": "AI Zero Network Circulation Observation v0.6",
  "description": "Schema for observable cyclic directional flow and circulation evidence in AI Zero Network v0.6.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "circulation_id",
    "window_start",
    "window_end",
    "region_refs",
    "cycle_count",
    "return_count"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.6"
    },

    "circulation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this Circulation Observation."
    },

    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the bounded circulation observation window."
    },

    "window_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the bounded circulation observation window."
    },

    "region_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "description": "Distinct Regions or logical nodes participating in the observed circulation."
    },

    "cycle_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of qualifying directed cycles observed during the window."
    },

    "return_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of qualifying return-flow events observed during the window."
    },

    "observation_state": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "provisional"
      ],
      "description": "Completeness state of the circulation observation."
    },

    "cycle_method": {
      "type": "string",
      "enum": [
        "directed_cycle_count_v1",
        "simple_cycle_count_v1",
        "bounded_return_cycle_v1"
      ],
      "description": "Method used to identify or count qualifying cycles."
    },

    "cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cycleRecord"
      },
      "description": "Optional reconstructable cycle evidence."
    },

    "derived": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "cycle_density": {
          "$ref": "#/$defs/derivedMetric"
        },

        "return_rate": {
          "$ref": "#/$defs/derivedMetric"
        },

        "circulation_strength": {
          "$ref": "#/$defs/derivedMetric"
        }
      }
    },

    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,

      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of consecutive or qualifying windows supporting persistence."
        },

        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Observed persistence duration in seconds."
        },

        "state": {
          "type": "string",
          "enum": [
            "appeared",
            "persisted",
            "strengthened",
            "weakened",
            "dissipated"
          ],
          "description": "Descriptive circulation-state transition."
        }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "flow_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Optional Region Flow identifiers used as directed-edge evidence."
        },

        "trace_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Optional Trace identifiers used as circulation evidence."
        },

        "edge_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Method used to construct the directed graph from observable records."
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },

        "analyzer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },

        "source_flow_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },

        "source_trace_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },

        "source_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  },

  "$defs": {
    "cycleRecord": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "cycle_id",
        "path"
      ],

      "properties": {
        "cycle_id": {
          "type": "string",
          "format": "uuid"
        },

        "path": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "Ordered directed path. Semantic validation MUST confirm that the final node returns to the first node."
        },

        "occurrence_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of observed occurrences of this normalized cycle."
        }
      }
    },

    "derivedMetric": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "value",
        "method"
      ],

      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },

        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Explicit method used to derive this circulation metric."
        }
      }
    }
  }
}
