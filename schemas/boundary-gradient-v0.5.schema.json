{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-zero-network/schemas/boundary-gradient-v0.5.schema.json",
  "title": "AI Zero Network Boundary Gradient v0.5",
  "description": "Schema for reconstructable metric differences between two distinct AI Zero Network Regions across a bounded comparison window.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "gradient_id",
    "boundary_id",
    "region_a",
    "region_b",
    "metric",
    "value_a",
    "value_b",
    "gradient",
    "method",
    "window_start",
    "window_end"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5"
    },

    "gradient_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this Boundary Gradient."
    },

    "boundary_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable logical identifier for the compared Region boundary."
    },

    "region_a": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "First Region in the comparison."
    },

    "region_b": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Second Region in the comparison."
    },

    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Metric whose compatible values are compared across the boundary."
    },

    "value_a": {
      "type": "number",
      "description": "Metric value observed or derived for region_a."
    },

    "value_b": {
      "type": "number",
      "description": "Metric value observed or derived for region_b."
    },

    "gradient": {
      "type": "number",
      "description": "Reported Boundary Gradient. Semantic validation reconstructs this value from value_a, value_b, and method."
    },

    "method": {
      "type": "string",
      "enum": [
        "absolute_difference",
        "directional_difference"
      ],
      "description": "Calculation rule used to derive the gradient."
    },

    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the comparison window."
    },

    "window_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the comparison window."
    },

    "comparison_state": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "provisional"
      ],
      "description": "Completeness state of the boundary comparison."
    },

    "temporal_alignment": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "same_window",
            "normalized",
            "aligned"
          ],
          "description": "How temporal compatibility between the compared Region values was established."
        },

        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Normalization or alignment method when mode is normalized or aligned."
        }
      },

      "required": [
        "mode"
      ],

      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "normalized",
                  "aligned"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "method"
            ]
          }
        }
      ]
    },

    "source": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "snapshot_a": {
          "type": "string",
          "format": "uuid",
          "description": "Optional source Field Snapshot for region_a."
        },

        "snapshot_b": {
          "type": "string",
          "format": "uuid",
          "description": "Optional source Field Snapshot for region_b."
        },

        "metric_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Optional identifier describing the metric semantics used on both sides of the comparison."
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },

        "analyzer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },

        "source_snapshot_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },

        "source_record_count": {
          "type": "integer",
          "minimum": 0
        },

        "source_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
