{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-zero-network/schemas/field-snapshot-v0.3.schema.json",
  "title": "AI Zero Network Field Snapshot v0.3",
  "description": "Schema for region-scoped, time-bounded field observations in AI Zero Network v0.3. Raw observations are kept separate from derived indicators.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "snapshot_id",
    "region",
    "window_start",
    "window_end",
    "observations"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3"
    },

    "snapshot_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this Field Snapshot."
    },

    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Logical observation region represented by this snapshot."
    },

    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive start of the observation window."
    },

    "window_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the observation window. Semantic validation MUST confirm window_end is later than window_start."
    },

    "observation_state": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "provisional"
      ],
      "description": "Optional completeness state of the observation window."
    },

    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_count",
        "receipt_count",
        "authority_request_count",
        "authority_grant_count",
        "authority_deny_count",
        "active_agent_count"
      ],

      "properties": {
        "trace_count": {
          "type": "integer",
          "minimum": 0
        },

        "receipt_count": {
          "type": "integer",
          "minimum": 0
        },

        "authority_request_count": {
          "type": "integer",
          "minimum": 0
        },

        "authority_grant_count": {
          "type": "integer",
          "minimum": 0
        },

        "authority_deny_count": {
          "type": "integer",
          "minimum": 0
        },

        "active_agent_count": {
          "type": "integer",
          "minimum": 0
        },

        "incoming_trace_count": {
          "type": "integer",
          "minimum": 0
        },

        "outgoing_trace_count": {
          "type": "integer",
          "minimum": 0
        },

        "cross_region_trace_count": {
          "type": "integer",
          "minimum": 0
        },

        "causal_edge_count": {
          "type": "integer",
          "minimum": 0
        },

        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0
            },

            "cost": {
              "type": "number",
              "minimum": 0
            },

            "compute_units": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },

    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activity_pressure": {
          "$ref": "#/$defs/derivedMetric"
        },

        "effective_pressure": {
          "$ref": "#/$defs/derivedMetric"
        },

        "authority_friction": {
          "$ref": "#/$defs/derivedMetric"
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },

        "collector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },

        "source_record_count": {
          "type": "integer",
          "minimum": 0
        },

        "source_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  },

  "$defs": {
    "derivedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "method"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },

        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Identifier or concise description of the derivation method."
        }
      }
    }
  }
}
