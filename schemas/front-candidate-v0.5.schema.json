{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-zero-network/schemas/front-candidate-v0.5.schema.json",
  "title": "AI Zero Network Front Candidate v0.5",
  "description": "Schema for provisional Front Candidate classifications derived from Boundary Gradient evidence in AI Zero Network v0.5.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "candidate_id",
    "boundary_id",
    "region_a",
    "region_b",
    "gradient_refs",
    "classification",
    "method",
    "window_start",
    "window_end"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5"
    },

    "candidate_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this Front Candidate."
    },

    "boundary_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable logical identifier for the Region boundary being classified."
    },

    "region_a": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "First Region participating in the candidate boundary."
    },

    "region_b": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Second Region participating in the candidate boundary."
    },

    "gradient_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Boundary Gradient identifiers used as evidence for this candidate."
    },

    "classification": {
      "type": "string",
      "const": "front_candidate",
      "description": "v0.5 permits only provisional Front Candidate classification."
    },

    "method": {
      "type": "string",
      "enum": [
        "single_metric_threshold_v1",
        "multi_metric_threshold_v1",
        "gradient_weighted_score_v1"
      ],
      "description": "Explicit classifier method used to derive the Front Candidate."
    },

    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the analysis interval."
    },

    "window_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the analysis interval."
    },

    "candidate_state": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "provisional"
      ],
      "description": "Completeness state of the evidence used for this candidate."
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Implementation-defined classifier confidence or score. It MUST NOT be interpreted as calibrated probability unless separately specified."
    },

    "strength": {
      "type": "string",
      "enum": [
        "weak",
        "moderate",
        "strong"
      ],
      "description": "Optional structural candidate strength. Semantic conformance requires explicit thresholds when used."
    },

    "thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      },
      "description": "Explicit metric thresholds used by threshold-based classification methods."
    },

    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "Explicit metric weights used by weighted classifier methods."
    },

    "score": {
      "type": "number",
      "minimum": 0,
      "description": "Optional classifier score produced by the declared method."
    },

    "persistence": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of consecutive or qualifying observations supporting persistence."
        },

        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Observed persistence duration in seconds."
        },

        "state": {
          "type": "string",
          "enum": [
            "appeared",
            "persisted",
            "weakened",
            "disappeared"
          ],
          "description": "Descriptive candidate lifecycle state."
        }
      },

      "minProperties": 1
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },

        "analyzer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },

        "source_gradient_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },

        "source_snapshot_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },

        "source_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "single_metric_threshold_v1",
              "multi_metric_threshold_v1"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "thresholds"
        ]
      }
    },

    {
      "if": {
        "properties": {
          "method": {
            "const": "gradient_weighted_score_v1"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "weights",
          "score"
        ]
      }
    },

    {
      "if": {
        "required": [
          "strength"
        ]
      },
      "then": {
        "required": [
          "thresholds"
        ]
      }
    }
  ]
}
